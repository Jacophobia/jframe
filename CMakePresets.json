{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "macos-debug",
            "inherits": "base",
            "displayName": "macOS Debug (Clang)",
            "description": "Uses CC/CXX env vars - set BESTOW_CC and BESTOW_CXX. Uses LLVM triplet for ABI compatibility.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm@20/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@20/bin/clang++",
                "CMAKE_OSX_SYSROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-llvm",
                "VCPKG_MANIFEST_FEATURES": "vulkan",
                "BESTOW_BUILD_VULKAN": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-release",
            "inherits": "base",
            "displayName": "macOS Release (Clang)",
            "description": "Uses CC/CXX env vars - set BESTOW_CC and BESTOW_CXX. Uses LLVM triplet for ABI compatibility.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BESTOW_DEV_TOOLS": "OFF",
                "BESTOW_BUILD_TESTS": "OFF",
                "BESTOW_BUILD_EXAMPLES": "OFF",
                "CMAKE_OSX_SYSROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-llvm"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-debug",
            "inherits": "base",
            "displayName": "Windows Debug (MSVC)",
            "description": "Uses MSVC 19.38+ for native C++23 import std support",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VCPKG_MANIFEST_FEATURES": "vulkan",
                "BESTOW_BUILD_VULKAN": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-release",
            "inherits": "base",
            "displayName": "Windows Release (MSVC)",
            "description": "Uses MSVC 19.38+ for native C++23 import std support",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BESTOW_DEV_TOOLS": "OFF",
                "BESTOW_BUILD_TESTS": "OFF",
                "BESTOW_BUILD_EXAMPLES": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "displayName": "Linux Debug (Clang)",
            "description": "Uses CC/CXX env vars - set BESTOW_CC and BESTOW_CXX. Uses libc++ triplet.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "displayName": "Linux Release (Clang)",
            "description": "Uses CC/CXX env vars - set BESTOW_CC and BESTOW_CXX. Uses libc++ triplet.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BESTOW_DEV_TOOLS": "OFF",
                "BESTOW_BUILD_TESTS": "OFF",
                "BESTOW_BUILD_EXAMPLES": "OFF",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        }
    ],
    "testPresets": [
        {
            "name": "base-test",
            "hidden": true,
            "output": {"outputOnFailure": true},
            "execution": {
                "jobs": 0,
                "stopOnFailure": false
            }
        },
        {
            "name": "macos-debug",
            "inherits": "base-test",
            "configurePreset": "macos-debug"
        },
        {
            "name": "windows-debug",
            "inherits": "base-test",
            "configurePreset": "windows-debug"
        },
        {
            "name": "linux-debug",
            "inherits": "base-test",
            "configurePreset": "linux-debug"
        }
    ]
}
