{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "macos-debug",
            "inherits": "base",
            "displayName": "macOS Debug (Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "JFRAME_ENABLE_ASAN": "ON",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm@20/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@20/bin/clang++",
                "CMAKE_OSX_SYSROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-release",
            "inherits": "base",
            "displayName": "macOS Release (Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "JFRAME_DEV_TOOLS": "OFF",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm@20/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@20/bin/clang++",
                "CMAKE_OSX_SYSROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-debug",
            "inherits": "base",
            "displayName": "Windows Debug (Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-release",
            "inherits": "base",
            "displayName": "Windows Release (Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "JFRAME_DEV_TOOLS": "OFF",
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "displayName": "Linux Debug (Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "JFRAME_ENABLE_ASAN": "ON",
                "CMAKE_C_COMPILER": "/home/linuxbrew/.linuxbrew/opt/llvm@20/bin/clang",
                "CMAKE_CXX_COMPILER": "/home/linuxbrew/.linuxbrew/opt/llvm@20/bin/clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "displayName": "Linux Release (Clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "JFRAME_DEV_TOOLS": "OFF",
                "CMAKE_C_COMPILER": "/home/linuxbrew/.linuxbrew/opt/llvm@20/bin/clang",
                "CMAKE_CXX_COMPILER": "/home/linuxbrew/.linuxbrew/opt/llvm@20/bin/clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        }
    ],
    "testPresets": [
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug",
            "output": {"outputOnFailure": true}
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": {"outputOnFailure": true}
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": {"outputOnFailure": true}
        }
    ]
}
