@PACKAGE_INIT@

# JFrame CMake Package Configuration
#
# This file is used by find_package(jframe) to locate the JFrame library.
#
# Usage:
#   find_package(jframe REQUIRED)
#   target_link_libraries(my_game PRIVATE jframe::jframe-core)
#
# Available targets:
#   jframe::jframe-core      - Main framework (includes all systems)
#   jframe::jframe-entity    - Entity Component System
#   jframe::jframe-graphics  - Graphics/Rendering
#   jframe::jframe-audio     - Audio system
#   jframe::jframe-input     - Input handling
#   jframe::jframe-physics   - Physics simulation
#   jframe::jframe-assets    - Asset management
#   jframe::jframe-events    - Event system
#   jframe::jframe-save      - Save/Load system
#   jframe::jframe-level     - Level management
#   jframe::jframe-ai        - AI/Pathfinding
#   jframe::jframe-camera    - Camera system
#   jframe::jframe-config    - Configuration
#   jframe::jframe-gas       - Gameplay Ability System
#   jframe::jframe-blueprints - Blueprint/Prefab system
#   jframe::jframe-dev       - Development tools (debug builds only)

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(spdlog)
find_dependency(glfw3)
find_dependency(glad)
find_dependency(SDL2)
find_dependency(glm)
find_dependency(EnTT)
find_dependency(nlohmann_json)
find_dependency(sol2)
find_dependency(cereal)
find_dependency(box2d)
find_dependency(freetype)
find_dependency(Taskflow)
find_dependency(imgui)
find_dependency(GTest)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/jframe-targets.cmake")

check_required_components(jframe)
